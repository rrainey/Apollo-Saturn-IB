+cmake_minimum_required(VERSION 3.16)
+project(yaAGC C)
+
+# Minimal libyaAGC: the AGC virtual machine and the small helpers actually
+# called from an embedded host.  Excluded from the original Makefile's
+# LIBOBJECTS: SocketAPI.c (host provides its own ChannelInput/Output;
+# for lib_SaturnIB those are in SaturnIBStack.cpp).
+#
+# Embed-only static lib (branch embed-yaagc tracks origin/master).
+# Diff vs upstream yaAGC/CMakeLists.txt: no SocketAPI / no yaAGC exe;
+# host supplies ChannelInput/Output/RequestRadarData (SaturnIBStack).
+# Local source patches on this branch: named `typedef struct agc_t`,
+# and dddConfigure() returns -1 instead of exit(1) when TSV specs are
+# missing.  Downlink UI needs dddConfigure("<RomStem>","") plus
+# ddd-*.tsv in CWD (see ApolloA/).
+set(YAAGC_SRC
+    agc_engine.c
+    agc_engine_init.c
+    agc_utilities.c
+    rfopen.c
+    Backtrace.c
+    DecodeDigitalDownlink.c
+)
+
+add_library(yaAGC STATIC ${YAAGC_SRC})
+
+set_target_properties(yaAGC PROPERTIES POSITION_INDEPENDENT_CODE ON)
+
+target_include_directories(yaAGC
+    PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}
+)
+
+target_compile_options(yaAGC PRIVATE
+    -Wno-implicit-function-declaration
+    -Wno-int-conversion
+    -Wno-incompatible-pointer-types
+    -Wno-format
+    -Wno-unused-result
+    -Wno-return-type
+    -Wno-parentheses
+    -Wno-pointer-sign
+    -Wno-deprecated-non-prototype
+)
+
+# NVER is stamped into version strings and expected as -DNVER=<n>.
+target_compile_definitions(yaAGC PRIVATE NVER=0)
